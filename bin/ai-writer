#!/bin/bash
# ai-writer: corrige o reescribe el texto seleccionado con un modelo local de Ollama.
#
# Uso: selecciona texto en cualquier ventana y pulsa CTRL+ALT+clic derecho
#      (o SUPER+ALT+W). Elige acción, tono y plataforma; el resultado se copia
#      al portapapeles y se pega sobre la selección.
#
# Variables opcionales:
#   AI_WRITER_MODEL   modelo de Ollama (por defecto gemma4:e4b)
#   OLLAMA_HOST       servidor de Ollama (por defecto http://127.0.0.1:11434)

set -uo pipefail

MODEL="${AI_WRITER_MODEL:-gemma4:e4b}"
HOST="${OLLAMA_HOST:-http://127.0.0.1:11434}"
[[ $HOST == http* ]] || HOST="http://$HOST"

notify() { notify-send -a "AI Writer" -i accessories-text-editor "$@"; }

# 1. Texto: la selección actual (primary); si no hay, el portapapeles.
text=$(wl-paste --primary --no-newline 2>/dev/null)
if [[ -z ${text//[[:space:]]/} ]]; then
  text=$(wl-paste --no-newline 2>/dev/null)
fi
if [[ -z ${text//[[:space:]]/} ]]; then
  notify "No hay texto" "Selecciona el texto (o cópialo) antes de usar el corrector."
  exit 1
fi

# 2. Detecta la plataforma a partir de la ventana activa.
win=$(hyprctl activewindow -j 2>/dev/null)
win_class=$(jq -r '.class // ""' <<<"$win")
win_title=$(jq -r '.title // ""' <<<"$win")
haystack="${win_class,,} ${win_title,,}"

detected="General"
case "$haystack" in
  *youtube*)                         detected="YouTube" ;;
  *twitter*|*" / x"*|*x.com*)        detected="Twitter/X" ;;
  *linkedin*)                        detected="LinkedIn" ;;
  *instagram*)                       detected="Instagram" ;;
  *facebook*)                        detected="Facebook" ;;
  *whatsapp*)                        detected="WhatsApp" ;;
  *telegram*)                        detected="Telegram" ;;
  *slack*)                           detected="Slack" ;;
  *discord*)                         detected="Discord" ;;
  *reddit*)                          detected="Reddit" ;;
  *tiktok*)                          detected="TikTok" ;;
  *gmail*|*outlook*|*thunderbird*|*mail*) detected="Email" ;;
  *github*|*gitlab*)                 detected="GitHub" ;;
esac

is_terminal=0
case "${win_class,,}" in
  *alacritty*|*kitty*|*foot*|*ghostty*|*wezterm*|*terminal*) is_terminal=1 ;;
esac

# 3. Menús. Con una acción como argumento (p. ej. ai-writer "Corregir ortografía")
#    se saltan: tono original y plataforma detectada.
if [[ -n ${1:-} ]]; then
  action=$1
  tone="Mantener el tono original"
  platform=$detected
else
action=$(omarchy-menu-select "Acción" \
  "Corregir ortografía" \
  "Mejorar redacción" \
  "Reescribir" \
  "Acortar" \
  "Alargar / desarrollar" \
  "Traducir al inglés" \
  "Traducir al español" -- --width 420) || exit 0

tone="Mantener el tono original"
if [[ $action != "Corregir ortografía" ]]; then
  tone=$(omarchy-menu-select "Tono" \
    "Mantener el tono original" \
    "Profesional" \
    "Formal" \
    "Cercano" \
    "Divertido" \
    "Persuasivo" \
    "Empático" \
    "Directo y conciso" \
    "Entusiasta" -- --width 420) || exit 0
fi

platforms=(General YouTube Twitter/X LinkedIn Instagram Facebook WhatsApp Telegram Slack Discord Reddit TikTok Email GitHub)
options=("Auto: $detected")
for p in "${platforms[@]}"; do [[ $p != "$detected" ]] && options+=("$p"); done
platform=$(omarchy-menu-select "Plataforma" "${options[@]}" -- --width 420) || exit 0
platform="${platform#Auto: }"
fi

# 4. Instrucciones.
case "$action" in
  "Corregir ortografía")    task="Corrige SOLO la ortografía, gramática, acentos y puntuación. No cambies el estilo, las palabras ni la estructura salvo lo imprescindible." ;;
  "Mejorar redacción")      task="Mejora la redacción: claridad, fluidez y corrección, conservando el significado y aproximadamente la misma longitud." ;;
  "Reescribir")             task="Reescribe el texto por completo con otras palabras, conservando el mensaje." ;;
  "Acortar")                task="Reescribe el texto de forma mucho más breve, conservando lo esencial." ;;
  "Alargar / desarrollar")  task="Desarrolla y amplía el texto con más detalle, sin inventar datos concretos." ;;
  "Traducir al inglés")     task="Traduce el texto al inglés de forma natural." ;;
  "Traducir al español")    task="Traduce el texto al español de España de forma natural." ;;
  *) notify -u critical "Acción desconocida" "$action"; exit 2 ;;
esac

case "$platform" in
  YouTube)    style="Es para YouTube (título, descripción o comentario): enganchador, claro, puede usar algún emoji con moderación." ;;
  Twitter/X)  style="Es un tuit para Twitter/X: máximo 280 caracteres, directo, sin relleno; hashtags solo si aportan." ;;
  LinkedIn)   style="Es para LinkedIn: profesional, párrafos cortos, orientado a aportar valor." ;;
  Instagram)  style="Es para Instagram: cercano, visual, emojis moderados y hashtags relevantes al final." ;;
  Facebook)   style="Es para Facebook: cercano y conversacional." ;;
  WhatsApp|Telegram) style="Es un mensaje de chat ($platform): natural, breve y conversacional." ;;
  Slack|Discord) style="Es un mensaje de $platform: claro y breve, apto para un canal de trabajo o comunidad." ;;
  Reddit)     style="Es para Reddit: natural, sin tono de marketing." ;;
  TikTok)     style="Es para TikTok: muy breve, llamativo, con gancho inicial." ;;
  Email)      style="Es un correo electrónico: estructura clara, saludo y despedida adecuados si procede." ;;
  GitHub)     style="Es para GitHub (issue, PR o comentario): técnico, preciso y conciso; respeta el Markdown y el código." ;;
  *)          style="Texto de uso general." ;;
esac

if [[ $action == Traducir* ]]; then
  lang_rule="Responde en el idioma de destino."
else
  lang_rule="Responde en el MISMO idioma del texto original."
fi

system="Eres un corrector y redactor experto. $task Tono: $tone. $style $lang_rule
Devuelve ÚNICAMENTE el texto final, sin comillas, sin explicaciones, sin encabezados ni notas."

# 5. Llamada a Ollama.
notify -t 3000 "Procesando…" "$action · $tone · $platform"

payload=$(jq -n --arg m "$MODEL" --arg s "$system" --arg t "$text" '{
  model: $m, stream: false, think: false, keep_alive: "15m",
  options: { temperature: 0.3 },
  messages: [ {role: "system", content: $s}, {role: "user", content: $t} ]
}')

response=$(curl -sS --max-time 180 "$HOST/api/chat" -d "$payload" 2>&1)
result=$(jq -r '.message.content // "" | gsub("^\\s+|\\s+$"; "")' <<<"$response" 2>/dev/null)

if [[ -z $result ]]; then
  err=$(jq -r '.error // empty' <<<"$response" 2>/dev/null)
  notify -u critical "Error de Ollama" "${err:-$response}"
  exit 1
fi

# 6. Entrega: portapapeles + pegar sobre la selección.
printf '%s' "$result" | wl-copy

if (( is_terminal )); then
  notify "Copiado al portapapeles" "$result"
else
  sleep 0.2
  wtype -M ctrl -k v -m ctrl
  notify -t 4000 "Texto reemplazado (también en el portapapeles)" "$result"
fi
